diff --git a/src/lib/launcher.js b/src/lib/launcher.js
new file mode 100644
index 000000000..92f512e44
--- /dev/null
+++ b/src/lib/launcher.js
@@ -0,0 +1,42 @@
+// Opens a task's work file in its DCC via a tiny localhost HTTP server (see
+// BB_Kitsu-Pipeline/launcher/bb_launch_server.py). Not a `bbkitsu://`-style
+// custom protocol - that route was tried first, and Chrome's handling of
+// custom protocol handlers turned out too unreliable to build on: neither a
+// Default Programs registration, a dedicated compiled exe, nor a real
+// `<a href>` got a real Chrome install past "the scheme does not have a
+// registered handler," with no difference found against a byte-for-byte
+// comparison to a definitely-working third-party registration. An ordinary
+// request to 127.0.0.1 sidesteps all of that - it is not a protocol handoff,
+// so none of those restrictions apply.
+const SERVER = 'http://127.0.0.1:53212'
+
+// Mirrors BB_core.versioning.format_version_tag/parse_version_tag - kept in
+// sync by hand rather than fetched from the server, since it is a plain
+// string format, not behaviour worth a round trip to ask for. Every
+// Blender/Nuke publish appends this to its Kitsu comment (BB_core.
+// versioning.tag_comment), which is the only durable link between a Kitsu
+// preview revision and the local scene version that produced it - Kitsu's
+// own revision counter advances on every publish, while a scene is only
+// saved when something changes worth a version bump, so the two drift apart
+// under completely normal use (several published angles off one saved
+// scene). A comment predating this feature, or one from a studio not
+// running this build yet, simply has no tag: treat that as "unknown," not
+// as version 0.
+const VERSION_TAG = /\[\[v(\d+)\]\]/
+
+export const parseVersionTag = text => {
+  const match = VERSION_TAG.exec(text || '')
+  return match ? parseInt(match[1], 10) : null
+}
+
+// `version` is a *local* work-file version - from parseVersionTag above, or
+// omitted to open the latest. Never Kitsu's bare revision number.
+export const launchTask = (taskId, version) => {
+  if (!taskId) return
+  const params = new URLSearchParams({ task_id: taskId })
+  if (version) params.set('version', version)
+  // fire-and-forget: the server has nothing useful to hand back beyond
+  // pass/fail, and a failed fetch (server not running) shouldn't throw in
+  // the caller's click handler.
+  fetch(`${SERVER}/launch?${params}`).catch(() => {})
+}
